# ALL OPTIONAL. Without them, the first visit shows a setup page that asks for the Jellyfin/Seerr/Tracearr
# addresses and keys and saves them in the data volume. Set variables here instead to skip that page.
# Never commit the filled-in copy.

# Connection details
PUBLIC_URL=https://jellypass.example.com   # must be https (sign-in cookies are Secure); the address members open
JELLYFIN_URL=http://jellyfin:8096          # reachable from the container
JELLYFIN_ADMIN_KEY=                        # Jellyfin: Dashboard > API Keys
SESSION_SECRET=                            # openssl rand -hex 32

# Optional integrations
SEERR_URL=
SEERR_API_KEY=
TRACEARR_URL=
TRACEARR_TOKEN=

# Email (invites, resets, notices). Easier to set in the app: Settings, Sign-in and email (with a test button).
MAIL_FROM=jellypass@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false                          # true for port 465
SMTP_USER=
SMTP_PASS=

# Default false: client IPs are the socket address. Set true ONLY when a reverse proxy you control is the sole way
# to reach the container (otherwise anyone can fake their IP and dodge sign-in rate limits). Pair with BIND_ADDR=127.0.0.1
# when the proxy is on the same host.
TRUST_PROXY=false
BIND_ADDR=0.0.0.0
# Sign-in challenge (Cloudflare Turnstile). Easier to set in the app: Settings, Sign-in and email, which has a quick guide.
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# Optional: encrypts API keys saved from the admin screen; web push (node scripts/gen-vapid.mjs)
KEYS_SECRET=
VAPID_KEYS=

# HTTPS. Leave TLS_MODE empty when a reverse proxy or Cloudflare Tunnel provides https.
#   TLS_MODE=self-signed   Jellypass makes its own certificate (browsers warn once). Add your LAN address in TLS_HOSTS.
#   TLS_MODE=custom        Use your own cert.pem and key.pem placed in the data volume under tls/.
TLS_MODE=
TLS_HOSTS=

# Cloudflare Tunnel (optional): set COMPOSE_PROFILES=tunnel and TUNNEL_TOKEN, then TRUST_PROXY=true.
COMPOSE_PROFILES=
TUNNEL_TOKEN=
